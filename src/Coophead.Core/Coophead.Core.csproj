<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lógica pura de Coophead: no referencia Unity, BepInEx ni ensamblados de Cuphead.
    net35: runtime que usan los plugins BepInEx 5 de Cuphead según la evidencia comunitaria
           (pendiente de confirmar en M0 contra la instalación local).
    netstandard2.0: solo para poder ejecutar las pruebas unitarias en .NET moderno.
  -->
  <PropertyGroup>
    <TargetFrameworks>net35;netstandard2.0</TargetFrameworks>
    <RootNamespace>Coophead.Core</RootNamespace>
    <AssemblyName>Coophead.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Coophead.Core.Tests" />
  </ItemGroup>

</Project>
